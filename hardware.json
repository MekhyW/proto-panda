{
    "_comment": "Any images loaded must have this exact size.",
    "canvas_width": 64, 
    "canvas_height": 32, 

    "enableAnimation": true,
    
    "display": {
        "type": "hub75",
        "enabled": true,
        "mirrorOtherHalf": true,
        "hub75": {
            "width": 64,
            "height": 32,
            "panels": 2,
            "horizontal_panel_count": 2,
            "colordepth": 12,
            "pins": {
                "dma_r1": 12,
                "dma_r2": 20,
                "dma_g1": 10,
                "dma_g2": 18,
                "dma_b1": 11,
                "dma_b2": 19,
                "dma_a": 17,
                "dma_b": 16,
                "dma_c": 15,
                "dma_d": 7,
                "dma_lat": 5,
                "dma_oe": 4,
                "dma_clk": 6
            }
        },
        "max7219": {
            "_comment": "Given 14 panels and each panel is 8x8, we have an area of 112 pixels. But mirrorOtherHalf=true will reserve the other half of the panel for mirroring it. So technically just 7 panels on each side and just 56 px",
            "panels": 14,
            "horizontal_panel_count": -1,
            "pins": {
                "cs": 10,
                "din": 11,
                "clk": 12 
            },
            "views": [
                {
                    "x": 0,
                    "y": 0,
                    "canvas_x": 0,
                    "canvas_y": 0,
                    "width": 32,
                    "height": 8
                },                
                {
                    "_comment": "EYE: Here we copy pixels from (0,10 to 16,18) and put them in position 32,0 to 48x8",
                    "x": 32,
                    "y": 0,
                    "canvas_x": 0,
                    "canvas_y": 10,
                    "width": 16,
                    "height": 8,
                    "flip_horizontal": true
                },
                {
                    "_comment": "NOSE: Here we copy pixels from (0,20 to 8,28) and put them in position 48,0 to 56x8",
                    "x": 48,
                    "y": 0,
                    "canvas_x": 0,
                    "canvas_y": 20,
                    "width": 8,
                    "height": 8,
                    "flip_horizontal": true
                }
            ]
        },
        "ws2812b":{
            "maxtrix_width": 8,
            "maxtrix_height": 8,
            "panels": 2,
            "horizontal_panel_count": 1,
            "brightness": 32
        }        
    }, 

    "servos": {
        "enabled": false,
        "pins": [1,2]
    },
    "leds": { 
        "pin_mode": "double",
        "_comment": "Modes allowed are: 'double' and 'single'. If using extra led strips, they'll all attach at the right led pin if double is set",

        "groups":[
            {
                "_comment": "If pin_side is undefined, it defaults to 'left'",
                "pin_side": "left",
                "led_count": 64,
                "mode": "pride"
            },
            {
                "pin_side": "right",
                "led_count": 64,
                "mode": "pride"
            }
        ]

    }
}

